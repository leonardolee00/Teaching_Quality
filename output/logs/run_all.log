. capture program drop write_table

. program define write_table
  1.     * Save the listed variables as a CSV file and as a LaTeX tabular. Column
.     * headings are the variable labels; numbers use each variable's display format.
.     syntax varlist using/
  2.     quietly export delimited `varlist' using "`using'.csv", replace datafmt
  3.     tempname tex
  4.     file open `tex' using "`using'.tex", write text replace
  5.     local align "l"
  6.     local columns : word count `varlist'
  7.     forvalues i = 2/`columns' {
  8.         local align "`align'r"
  9.     }
 10.     file write `tex' "\begin{tabular}{`align'}" _n "\hline" _n
 11.     local line
 12.     foreach v of local varlist {
 13.         local label : variable label `v'
 14.         if `"`label'"' == "" local label `v'
 15.         local label = subinstr(`"`label'"', "_", "\_", .)
 16.         if `"`line'"' != "" local line `"`line' & "'
 17.         local line `"`line'`label'"'
 18.     }
 19.     file write `tex' `"`line' "' _char(92) _char(92) _n "\hline" _n
 20.     forvalues i = 1/`=_N' {
 21.         local line
 22.         foreach v of local varlist {
 23.             capture confirm string variable `v'
 24.             if !_rc {
 25.                 local cell = `v'[`i']
 26.             }
 27.             else if missing(`v'[`i']) {
 28.                 local cell "--"
 29.             }
 30.             else {
 31.                 local fmt : format `v'
 32.                 local cell : display `fmt' `v'[`i']
 33.             }
 34.             local cell = strtrim(`"`cell'"')
 35.             local cell = subinstr(`"`cell'"', "_", "\_", .)
 36.             if `"`line'"' != "" local line `"`line' & "'
 37.             local line `"`line'`cell'"'
 38.         }
 39.         file write `tex' `"`line' "' _char(92) _char(92) _n
 40.     }
 41.     file write `tex' "\hline" _n "\end{tabular}" _n
 42.     file close `tex'
 43. end

