Running simulation/Run_simulations.do...

. /*
> Simulations
> 
> Purpose: Run the simulation experiments of the EC428 essay (Section 4) with the
> exact household solver.
> 1. Households: the saved simulated households, or new draws made in Stata.
> 2. Theory checks: seven properties of the model (essay Table 1).
> 3. Baseline: additive health shocks tau = 0, .05, ..., .40 at the baseline
>    calibration (essay Tables 3 and 5; Figures 1, 2, 3 and 5).
> 4. Parameter regions: every admissible parameter vector of essay Table 8 with
>    each of the 24 shocks (essay Tables 2, 4 and 7; Figures 4, 6, 7, 9 and 10).
> 5. Robustness: kappa, eta or rho varied one at a time (essay Table 6).
> 
> Input: data/simulated/baseline_households.csv and grid_households.csv
> (not used when new households are drawn).
> Requirements: Stata 17 or later.
> 
> Outputs, all in data/derived/:
> - households_baseline.dta, households_grid.dta: the households used
> - validation_checks.dta: theory checks
> - baseline_results.dta, baseline_choices.dta: baseline experiment
> - parameter_regions.dta: every parameter-shock run
> - robustness.dta: robustness runs
> - run_settings.dta: the settings of this run
> 
> Run from the project root via run_all.do or do simulation/Run_simulations.do.
> Optional arguments: project root, quick test (0/1), new households (0/1), seed.
> */
. 
. version 17

. clear all

. set more off

. 
. args project_root quick_test new_households seed

. if `"`project_root'"' == "" local project_root "`c(pwd)'"

. if "`quick_test'" == "" local quick_test = 0

. if "`new_households'" == "" local new_households = 0

. if "`seed'" == "" local seed = 123

. 
. capture confirm file "`project_root'/run_all.do"

. if _rc {
.     display as error "Run from the project root: cd to the folder containing run_all.do."
.     exit 601
. }

. local data "`project_root'/data/derived"

. capture mkdir "`project_root'/data"

. capture mkdir "`data'"

. run "`project_root'/model/Household_model.do"

. 
. * Baseline calibration (essay Section 4), in the order A_A A_N beta gamma rho kappa eta.
. local calibration 1 1.80 1 .55 .80 .25 1.25

. 
. capture program drop add_calibration

. program define add_calibration
  1.     * Add the baseline calibration to every observation as variables A_A-eta.
.     args A_A A_N beta gamma rho kappa eta
  2.     foreach p in A_A A_N beta gamma rho kappa eta {
  3.         generate double `p' = ``p''
  4.     }
  5. end

. 
. capture program drop compare_with_no_shock

. program define compare_with_no_shock
  1.     * Compare each run with the no-shock run (shock_id 0) of the same parameter
.     * vector, and classify it as in essay Section 4 and Table 2.
.     sort parameter_id shock_id
  2.     by parameter_id: assert shock_id[1] == 0 & shock_type[1] == 0
  3.     foreach v in migration_rate ag_output nonag_output welfare lp_a lp_n apg {
  4.         by parameter_id: generate double d_`v' = `v' - `v'[1]
  5.     }
  6.     * APG changes count only if both sectors are active before and after the shock.
.     by parameter_id: generate byte apg_valid = ag_workers > 0 & nonag_workers > 0 & ///
>         ag_workers[1] > 0 & nonag_workers[1] > 0 & !missing(d_apg)
  7.     generate byte apg_direction = cond(d_apg > .01, 1, cond(d_apg < -.01, 3, 2)) if apg_valid
  8.     * Core mechanism: migration and welfare rise, and migrants are healthier than
.     * farm stayers (health before the shock). When no one is left on the farm the
.     * health comparison is undefined; as in the essay's tables, the run counts.
.     generate byte selected = initial_health_migrants > initial_health_stayers + 1e-10 ///
>         if nonag_workers > 0 & ag_workers > 0
  9.     generate byte core_mechanism = d_migration_rate > 1e-10 & d_welfare > 1e-10 & ///
>         (selected == 1 | ag_workers == 0)
 10.     generate byte ag_output_decline = d_ag_output < -1e-10
 11.     drop selected
 12.     label define direction 1 "Widening" 2 "About unchanged" 3 "Narrowing", replace
 13.     label values apg_direction direction
 14.     label variable apg_valid "Both sectors active before and after the shock"
 15.     label variable apg_direction "Change in APG: above .01, within .01, below -.01"
 16.     label variable core_mechanism "Migration and welfare rise; migrants positively selected"
 17.     label variable ag_output_decline "Farm output falls"
 18. end

. 
. capture program drop label_runs

. program define label_runs
  1.     label variable parameter_id "Parameter vector"
  2.     label variable shock_id "Shock"
  3.     label variable shock_type "Shock family"
  4.     label variable tau "Health shock, tau"
  5.     label variable lambda "Migration-cost multiplier, lambda"
  6.     label variable tau_a "Farm health shock, tau_A"
  7.     label variable tau_m "Market health shock, tau_M"
  8.     label define shock_family 0 "No shock" 1 "Additive health" 2 "Multiplicative health" ///
>         3 "Migration cost" 4 "Two health indices", replace
  9.     label values shock_type shock_family
 10. end

. 
. 
. * 1. Households: one row per person (hh_id member_id health land).
. foreach sample in baseline grid {
  2.     if `new_households' {
  3.         * Draws as in essay Section 3.1: size uniform on 3-6; land log-normal with
.         * log mean 0 and log SD .30; health = .10 + .90 * logistic(xi + e), where
.         * xi ~ N(0, .60^2) is shared within the household and e ~ N(0, .70^2).
.         local households = cond("`sample'" == "baseline", 10000, 1000)
  4.         clear
  5.         set seed `seed'
  6.         quietly set obs `households'
  7.         generate long hh_id = _n
  8.         generate byte hh_size = 3 + floor(4 * runiform())
  9.         generate double land = exp(.30 * rnormal())
 10.         generate double xi = .60 * rnormal()
 11.         quietly expand hh_size
 12.         bysort hh_id: generate byte member_id = _n
 13.         generate double health = .10 + .90 * invlogit(xi + .70 * rnormal())
 14.         keep hh_id member_id health land
 15.     }
 16.     else {
 17.         import delimited using "`project_root'/data/simulated/`sample'_households.csv", ///
>             clear varnames(1) asdouble
 18.     }
 19.     if `quick_test' {
 20.         quietly keep if hh_id <= cond("`sample'" == "baseline", 500, 250)
 21.     }
 22. 
.     sort hh_id member_id
 23.     isid hh_id member_id
 24.     assert !missing(health, land)
 25.     assert health > 0 & health <= 1 & land > 0
 26.     by hh_id: assert member_id == _n
 27.     by hh_id: assert land == land[1]
 28.     by hh_id: assert _N <= 6
 29.     label variable hh_id "Household"
 30.     label variable member_id "Member"
 31.     label variable health "Health before any shock"
 32.     label variable land "Household land"
 33.     quietly count if member_id == 1
 34.     display as text "`sample' households: " r(N) " households, " _N " members."
 35.     save "`data'/households_`sample'.dta", replace
 36. }
