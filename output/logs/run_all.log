.     local gamma_values .45 .55 .65 .75
.     local rho_values   .70 .80 .90 1
.     local eta_values   .75 1.25 1.75 2.25
.     local kappa_values .15 .25 .40 .60
. }

. 
. tempfile parameters shocks

. tempname grid

. postfile `grid' long parameter_id double(A_N gamma rho eta kappa) using "`parameters'"

. local id = 0

. foreach A_N of local A_N_values {
  2.     foreach gamma of local gamma_values {
  3.         foreach rho of local rho_values {
  4.             * The essay requires 0 < gamma < rho <= 1.
.             if `gamma' >= `rho' continue
  5.             foreach eta of local eta_values {
  6.                 foreach kappa of local kappa_values {
  7.                     local ++id
  8.                     post `grid' (`id') (`A_N') (`gamma') (`rho') (`eta') (`kappa')
  9.                 }
 10.             }
 11.         }
 12.     }
 13. }

. postclose `grid'

. 
. * Shock intensity: tau for health shocks, 1 - lambda for the cost shock and
. * tau_M for the two-index shock.
. postfile `grid' byte(shock_id shock_type) double(tau lambda tau_a tau_m intensity) ///
>     using "`shocks'"

. post `grid' (0) (0) (0) (1) (0) (0) (0)

. local id = 0

. foreach type in 1 2 {
  2.     foreach tau in .10 .20 .30 .40 {
  3.         local ++id
  4.         post `grid' (`id') (`type') (`tau') (1) (0) (0) (`tau')
  5.     }
  6. }

. foreach lambda in 1 .90 .80 .70 .60 {
  2.     local ++id
  3.     post `grid' (`id') (3) (0) (`lambda') (0) (0) (1 - `lambda')
  4. }

. foreach tau_a in 0 .10 .20 {
  2.     foreach tau_m in .10 .20 .30 .40 {
  3.         if `tau_m' < `tau_a' continue
  4.         local ++id
  5.         post `grid' (`id') (4) (0) (1) (`tau_a') (`tau_m') (`tau_m')
  6.     }
  7. }

. postclose `grid'

