. esttab using "`outdir'/AppTable5.tex", replace ///
>     b(3) se(3) star(* 0.10 ** 0.05 *** 0.01) ///
>     stats(N levels_tm gains_tm pfp_tm, labels("Observations" "Levels Incentive" "Gains Incentive" "Pay-for-Percentile")) ///
>     drop(*countyid*) ///
>     label booktabs ///
