. /*TABLE 4: Impacts on question difficulty subscores and curricular coverage*/
. 
. eststo clear

. foreach var of varlist $item_difficulty {
  2.         eststo: xi: reg `var' $inc_design $base_covs $other_covs i.countyid, vce(cluster schid)
  3. 
.         lincom gains - levels
  4.         estadd scalar gains_levels = round(`r(estimate)',0.001)
  5.         local t = `r(estimate)'/`r(se)'
  6.         estadd scalar gains_levels_p = round(2*ttail(e(df_r),abs(`t')),0.001)
  7.         
.         lincom p4p - levels
  8.         estadd scalar p4p_levels = round(`r(estimate)',0.001)
  9.         local t = `r(estimate)'/`r(se)'
 10.         estadd scalar p4p_levels_p = round(2*ttail(e(df_r),abs(`t')),0.001)
 11.         
.         lincom p4p - gains
 12.         estadd scalar p4p_gains = round(`r(estimate)',0.001)
 13.         local t = `r(estimate)'/`r(se)'
 14.         estadd scalar p4p_gains_p = round(2*ttail(e(df_r),abs(`t')),0.001)
 15.         
.         su z_final_score if e(sample)==1 & control==1
 16.         estadd scalar mean =  round(`r(mean)',0.001)
 17.         
.         testparm levels gains p4p, equal
 18.                                                                                                 
.         estadd scalar testequal_p = round(`r(p)',0.001)
 19. }
